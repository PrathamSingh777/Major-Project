<nav class="site-navbar">
  <div class="container-custom">
    <div class="navbar-inner">
      <!-- Brand Logo -->
      <a class="brand-link" href="/listings">
        wanderlust<span class="brand-dot">.</span>
      </a>

      <!-- Center Floating Pill Search Bar (Matching Photos 2 & 3) -->
      <div class="search-pill-wrapper d-none d-md-flex">
        <form class="search-pill-form" action="/listings" method="GET">
          <div class="pill-segment">
            <input type="text" name="q" placeholder="Where to go?" aria-label="Search destination" id="navSearchInput">
          </div>
          <div class="pill-divider"></div>
          <div class="pill-label-trigger">
            When?
          </div>
          <div class="pill-divider"></div>
          <div class="pill-label-trigger">
            Guests
          </div>
          <button class="search-btn-circle" type="submit" aria-label="Search">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </form>
      </div>

      <!-- Right Navigation Actions -->
      <div class="navbar-actions">
        <a class="host-link d-none d-sm-inline-block" href="/listings/new">
          Host a stay
        </a>

        <!-- User Dropdown Pill -->
        <div class="dropdown">
          <button class="user-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
            <i class="fa-solid fa-bars" style="font-size: 0.85rem;"></i>
            <div class="user-avatar-circle">
              <i class="fa-solid fa-user"></i>
            </div>
          </button>
          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
            <% if(!currUser) { %>
              <li><a class="dropdown-item dropdown-item-custom" href="/signup">Sign up</a></li>
              <li><a class="dropdown-item dropdown-item-custom" href="/login">Log in</a></li>
              <li><hr class="dropdown-divider my-1"></li>
              <li><a class="dropdown-item dropdown-item-custom" href="/listings/new">Host a stay</a></li>
            <% } else { %>
              <li class="px-3 py-2 text-muted" style="font-size: 0.82rem;">
                Signed in as <strong class="text-dark"><%= currUser.username %></strong>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <li><a class="dropdown-item dropdown-item-custom" href="/listings/new">Host your property</a></li>
              <li><a class="dropdown-item dropdown-item-custom" href="/logout">Log out</a></li>
            <% } %>
          </ul>
        </div>
      </div>
    </div>

    <!-- Mobile Search Form (only on small screens) -->
    <div class="d-md-none mt-2 pt-2 border-top">
      <form class="d-flex" action="/listings" method="GET">
        <input class="form-control me-2" type="search" name="q" placeholder="Where to go?" aria-label="Search destination" style="border-radius: 9999px; background: #fff; border: 1px solid var(--border-subtle);">
        <button class="search-btn-circle" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>
  </div>
</nav>
