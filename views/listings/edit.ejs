<% layout("/layouts/boilerplate.ejs") %>

<div class="container-custom py-4">
  <div class="form-page-card">
    <div class="mb-4">
      <a href="/listings/<%= listing._id %>" class="text-secondary small text-decoration-none">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to listing
      </a>
      <h1 class="form-page-title mt-2 mb-1">Edit Listing</h1>
      <p class="text-secondary small">Update the details and photography for <%= listing.title %></p>
    </div>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data" class="needs-validation" id="editListingForm" novalidate>
      <div class="auth-form-group">
        <label for="title" class="auth-label">Property Title</label>
        <input 
          type="text" 
          name="listing[title]" 
          id="title" 
          value="<%= listing.title %>" 
          class="auth-input-control" 
          required
        >
      </div>
      
      <div class="auth-form-group">
        <label for="description" class="auth-label">Description</label>
        <textarea 
          name="listing[description]" 
          id="description" 
          rows="4" 
          class="auth-input-control" 
          required
        ><%= listing.description %></textarea>
      </div>
    
      <div class="auth-form-group"> 
        <label class="auth-label">Current Photograph</label>
        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 border">
          <img src="<%= originalImgUrl %>" alt="Current listing photo" style="height: 100px; width: 140px; object-fit: cover; border-radius: var(--radius-sm);">
          <div class="small text-secondary">
            Upload a replacement file below if you wish to change the cover picture.
          </div>
        </div>
      </div>
        
      <div class="auth-form-group">
        <label for="image" class="auth-label">Upload New Photograph (Optional)</label>
        <input 
          type="file" 
          name="listing[image]" 
          id="image" 
          class="auth-input-control" 
          accept="image/*"
        >
        <div id="imageOptStatus" class="mt-1 small text-secondary" style="font-size: 0.82rem;"></div>
      </div>
        
      <div class="row g-3">
        <div class="col-md-6 auth-form-group">
          <label for="price" class="auth-label">Price per night (&#8377;)</label>
          <input 
            type="number" 
            name="listing[price]" 
            id="price" 
            value="<%= listing.price %>" 
            min="0" 
            class="auth-input-control" 
            required
          >
        </div>

        <div class="col-md-6 auth-form-group">
          <label for="country" class="auth-label">Country</label>
          <input 
            type="text" 
            name="listing[country]" 
            id="country" 
            value="<%= listing.country %>" 
            class="auth-input-control" 
            required
          >
        </div>
      </div>
      
      <div class="auth-form-group">
        <label for="location" class="auth-label">City / Location</label>
        <input 
          type="text" 
          name="listing[location]" 
          id="location" 
          value="<%= listing.location %>" 
          class="auth-input-control" 
          required
        >
      </div>
      
      <div class="pt-3">
        <button type="submit" id="submitBtn" class="btn btn-dark w-100 py-3 fw-semibold d-flex align-items-center justify-content-center gap-2" style="border-radius: var(--radius-sm); background: #1C1917;">
          <span id="btnText">Save Changes</span>
          <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const imageInput = document.getElementById("image");
  const optStatus = document.getElementById("imageOptStatus");

  if (imageInput) {
    imageInput.addEventListener("change", async function () {
      const file = this.files[0];
      if (!file) return;

      const originalSizeMB = (file.size / (1024 * 1024)).toFixed(2);

      if (file.size > 1024 * 1024) {
        optStatus.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1 text-primary"></i> Optimizing image...';
        try {
          const optimizedFile = await compressImageFile(file, 1600, 0.85);
          const newSizeKB = Math.round(optimizedFile.size / 1024);
          const dataTransfer = new DataTransfer();
          dataTransfer.items.add(optimizedFile);
          this.files = dataTransfer.files;
          optStatus.innerHTML = `<i class="fa-solid fa-circle-check text-success me-1"></i> Optimized for high speed: <strong>${originalSizeMB} MB &rarr; ${newSizeKB} KB</strong>`;
        } catch (err) {
          optStatus.innerHTML = `File ready: ${originalSizeMB} MB`;
        }
      }
    });
  }

  function compressImageFile(file, maxWidth, quality) {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = (e) => {
        const img = new Image();
        img.src = e.target.result;
        img.onload = () => {
          let width = img.width;
          let height = img.height;
          if (width > maxWidth) {
            height = Math.round((height * maxWidth) / width);
            width = maxWidth;
          }
          const canvas = document.createElement("canvas");
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, width, height);
          canvas.toBlob((blob) => {
            if (!blob) return resolve(file);
            const optimized = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
              type: "image/jpeg",
              lastModified: Date.now()
            });
            resolve(optimized);
          }, "image/jpeg", quality);
        };
        img.onerror = () => resolve(file);
      };
      reader.onerror = () => resolve(file);
    });
  }

  const form = document.getElementById("editListingForm");
  const submitBtn = document.getElementById("submitBtn");
  const btnText = document.getElementById("btnText");
  const btnSpinner = document.getElementById("btnSpinner");

  if (form) {
    form.addEventListener("submit", function () {
      if (this.checkValidity()) {
        submitBtn.style.opacity = "0.8";
        submitBtn.style.pointerEvents = "none";
        btnText.innerText = "Saving & Uploading...";
        btnSpinner.classList.remove("d-none");
      }
    });
  }
</script>
