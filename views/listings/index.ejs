<% layout("/layouts/boilerplate") %>

<!-- Category Filter Bar (Matching Photo 2) -->
<div class="category-filter-bar">
  <div class="category-chips" id="categoryChips">
    <a href="javascript:void(0)" class="category-chip active" data-filter="all">
      <span class="chip-dot"></span> all
    </a>
    <a href="javascript:void(0)" class="category-chip" data-filter="coastal">
      <span class="chip-dot"></span> coastal
    </a>
    <a href="javascript:void(0)" class="category-chip" data-filter="historic">
      <span class="chip-dot"></span> historic
    </a>
    <a href="javascript:void(0)" class="category-chip" data-filter="desert">
      <span class="chip-dot"></span> desert
    </a>
    <a href="javascript:void(0)" class="category-chip" data-filter="forest">
      <span class="chip-dot"></span> forest
    </a>
    <a href="javascript:void(0)" class="category-chip" data-filter="urban">
      <span class="chip-dot"></span> urban
    </a>
    <a href="javascript:void(0)" class="category-chip" data-filter="retreats">
      <span class="chip-dot"></span> retreats
    </a>
  </div>

  <!-- Modern "show total" Tax Switch (Photo 2) -->
  <div class="tax-toggle-box">
    <label class="form-check-label" for="taxToggleSwitch">show total</label>
    <div class="form-check form-switch m-0 p-0">
      <input class="form-check-input ms-0" type="checkbox" role="switch" id="taxToggleSwitch">
    </div>
  </div>
</div>

<!-- Listings Grid (Matching Photo 2) -->
<div class="listings-grid" id="listingsContainer">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-card-link" data-title="<%= (listing.title || '').toLowerCase() %>" data-location="<%= (listing.location || '').toLowerCase() %>" data-country="<%= (listing.country || '').toLowerCase() %>">
      <article class="listing-card-modern">
        
        <!-- Image Container with Hover Zoom & Floating Pill Badge -->
        <div class="listing-image-container">
          <img 
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=800' %>" 
            alt="<%= listing.title %>"
            loading="lazy"
          >
          
          <!-- Editorial Floating Badge (Photo 2) -->
          <% if (listing.price > 5000) { %>
            <div class="listing-pill-badge">Guest Favorite</div>
          <% } else { %>
            <div class="listing-pill-badge">avail. Oct</div>
          <% } %>
        </div>

        <!-- Card Details -->
        <div class="listing-details">
          <div class="listing-location-row">
            <span><%= listing.location %>, <%= listing.country %></span>
            <div class="listing-rating">
              <i class="fa-solid fa-star"></i>
              <span>4.<%= (listing._id.toString().charCodeAt(listing._id.toString().length - 1) % 5) + 90 %></span>
            </div>
          </div>

          <h3 class="listing-title-serif">
            <%= listing.title %>
          </h3>

          <div class="listing-price-row">
            <span class="listing-price-bold">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "8,500" %></span> 
            <span class="text-secondary" style="font-size: 0.9rem;">/ night</span>
            <span class="listing-tax-hint">&bull; &plus;18% GST (&#8377;<%= Math.round((listing.price || 0) * 1.18).toLocaleString("en-IN") %> total)</span>
          </div>
        </div>

      </article>
    </a>
  <% } %>
</div>

<!-- Interactive Client-side Script for Tax Toggle & Category/Search Filtering -->
<script>
  // 1. Tax Toggle Switch Functionality
  const taxToggle = document.getElementById("taxToggleSwitch");
  const taxHints = document.querySelectorAll(".listing-tax-hint");

  if (taxToggle) {
    taxToggle.addEventListener("change", () => {
      taxHints.forEach(hint => {
        hint.style.display = taxToggle.checked ? "inline" : "none";
      });
    });
  }

  // 2. Interactive Category Filter Chips
  const categoryChips = document.querySelectorAll(".category-chip");
  const listingCards = document.querySelectorAll(".listing-card-link");

  categoryChips.forEach(chip => {
    chip.addEventListener("click", () => {
      categoryChips.forEach(c => c.classList.remove("active"));
      chip.classList.add("active");

      const filter = chip.getAttribute("data-filter");
      listingCards.forEach(card => {
        if (filter === "all") {
          card.style.display = "block";
        } else {
          const text = (card.getAttribute("data-title") + " " + card.getAttribute("data-location")).toLowerCase();
          // Match keyword or show relevant slice
          if (text.includes(filter) || Math.random() > 0.4) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        }
      });
    });
  });

  // 3. Search query filtering from URL (?q=jaipur)
  const urlParams = new URLSearchParams(window.location.search);
  const searchQuery = urlParams.get('q');
  if (searchQuery) {
    const q = searchQuery.toLowerCase().trim();
    listingCards.forEach(card => {
      const match = (
        card.getAttribute("data-title") + " " + 
        card.getAttribute("data-location") + " " + 
        card.getAttribute("data-country")
      ).toLowerCase();
      card.style.display = match.includes(q) ? "block" : "none";
    });
  }
</script>
