<% layout("/layouts/boilerplate")%>

<style>
 #filters {
  margin-top: 1rem;
  font-size: 1.1rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

#filters .filters-items {
  display: flex;
  align-items: center;
  gap: 2rem;
  flex: 1;
  overflow-x: auto;
}

#filters .item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  white-space: nowrap;
}

#filters i {
  font-size: 1.4rem;
}

.item {
  opacity: 0.7;
}

.item:hover {
  opacity: 1;
  cursor: pointer;
}

.tax-info {
  font-size: 0.9rem;
  color: gray;
  display: none;
}

.tax-toggle-container {
  margin-left: auto;
   border: 2px solid #000000;
  border-radius: 30px;
  padding: 10px;
}

.tax-toggle-container .form-check {
  display: flex;
  align-items: center;
  gap: 15px;
  margin: 0;
  border: 2px solid #000000;
  border-radius: 30px;
  padding: 12px 25px;
  background: #fff;
  white-space: nowrap;
}

.tax-toggle-container .form-check-label {
  margin: 0;
  font-size: 1rem;
  color: #333;
}

</style>
<div id="filters">
  <div class="filters-items">
    <div class="item">
      <i class="fa-solid fa-fire"></i>
      <span>Trending</span>
    </div>

    <div class="item">
      <i class="fa-solid fa-bed"></i>
      <span>Rooms</span>
    </div>

    <div class="item">
      <i class="fa-solid fa-mountain-city"></i>
      <span>Iconic cities</span>
    </div>

    <div class="item">
      <i class="fa-solid fa-mountain"></i>
      <span>mountains</span>
    </div>

    <div class="item">
      <i class="fa-brands fa-fort-awesome"></i>
      <span>castles</span>
    </div>

    <div class="item">
      <i class="fa-solid fa-campground"></i>
      <span>camping</span>
    </div>

    <div class="item">
      <i class="fa-solid fa-tractor"></i>
      <span>farms </span>
    </div>

   
  </div>

  <div class="tax-toggle-container">
    <div class="form-check-reverse tax-toggle form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>



<body>
    <!-- <h3 class="mt-2">All Listings</h3> -->

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-1"> 
 <% for( let listing of allListings){%>

   <a href="/listings/<%=listing._id%>" class="listing-link">
<div class="card  listing-card" >
  <img src="<%=listing.image.url%>" 
  class="card-img-top "
   alt="listing_image" 
   style="height: 18rem" >

  <div class="card-img-overlay">aba</div>
  
  <div class="card-body">
    <p class="card-text">
        <b><%=listing.title%></b> <br>
  &#8377 <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>/night <br>
<i class="tax-info">+18% GST</i>
    </p>
  </div>
</div>
</a>
<% }%>
</div>


<script>
  let taxSwitch= document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
    console.log("clicked");

    let taxInfos= document.querySelectorAll(".tax-info");
    for(info of taxInfos){
      if(taxSwitch.checked){
        info.style.display="inline";
      }else{
        info.style.display="none";
      }
    }
  })
</script>
   


</body>
