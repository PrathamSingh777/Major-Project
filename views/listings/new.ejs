<% layout("/layouts/boilerplate.ejs") %>

<div class="container-custom py-4">
  <div class="form-page-card">
    <div class="mb-4">
      <a href="/listings" class="text-secondary small text-decoration-none">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to all listings
      </a>
      <h1 class="form-page-title mt-2 mb-1">Host a New Slow Stay</h1>
      <p class="text-secondary small">Share your sanctuary with travelers seeking mindful, timeless retreats.</p>
    </div>

    <form method="POST" action="/listings" enctype="multipart/form-data" class="needs-validation" id="newListingForm" novalidate>
      <div class="auth-form-group">
        <label for="title" class="auth-label">Property Title</label>
        <input 
          type="text" 
          name="listing[title]" 
          id="title" 
          placeholder="e.g., Riverside Ganges Sanctuary & Camp — Rishikesh" 
          class="auth-input-control" 
          required
        >
      </div>
      
      <div class="auth-form-group">
        <label for="description" class="auth-label">Story & Description</label>
        <textarea 
          name="listing[description]" 
          id="description" 
          rows="4" 
          placeholder="Describe the architectural highlights, calmness, and unique character of this stay..." 
          class="auth-input-control" 
          required
        ></textarea>
      </div>

      <div class="auth-form-group">
        <label for="image" class="auth-label">Cover Photograph</label>
        <input 
          type="file" 
          name="listing[image]" 
          id="image" 
          class="auth-input-control" 
          accept="image/*"
          required
        >
        <div id="imageOptStatus" class="mt-1 small text-secondary" style="font-size: 0.82rem;">
          Upload a high-resolution photograph (JPEG, PNG, or WebP).
        </div>
      </div>
      
      <div class="row g-3">
        <div class="col-md-6 auth-form-group">
          <label for="price" class="auth-label">Price per night (&#8377;)</label>
          <input 
            type="number" 
            name="listing[price]" 
            id="price" 
            placeholder="e.g., 4200" 
            min="0" 
            class="auth-input-control" 
            required
          >
        </div>
        
        <div class="col-md-6 auth-form-group">
          <label for="country" class="auth-label">Country</label>
          <input 
            type="text" 
            name="listing[country]" 
            id="country" 
            placeholder="e.g., India" 
            class="auth-input-control" 
            required
          >
        </div>
      </div>
      
      <div class="auth-form-group">
        <label for="location" class="auth-label">City / Location</label>
        <input 
          type="text" 
          name="listing[location]" 
          id="location" 
          placeholder="e.g., Rishikesh, Uttarakhand" 
          class="auth-input-control" 
          required
        >
      </div>
      
      <div class="pt-3">
        <button type="submit" id="submitBtn" class="btn btn-dark w-100 py-3 fw-semibold d-flex align-items-center justify-content-center gap-2" style="border-radius: var(--radius-sm); background: #1C1917;">
          <span id="btnText">Publish Listing</span>
          <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // 1. Instant Client-Side Image Optimizer
  // Compresses large phone/camera images (e.g. 8MB -> 400KB) before upload for blazing fast speed
  const imageInput = document.getElementById("image");
  const optStatus = document.getElementById("imageOptStatus");

  if (imageInput) {
    imageInput.addEventListener("change", async function () {
      const file = this.files[0];
      if (!file) return;

      const originalSizeMB = (file.size / (1024 * 1024)).toFixed(2);

      // If file > 1MB, optimize it in memory via canvas
      if (file.size > 1024 * 1024) {
        optStatus.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1 text-primary"></i> Optimizing photograph for fast cloud upload...';
        
        try {
          const optimizedFile = await compressImageFile(file, 1600, 0.85);
          const newSizeKB = Math.round(optimizedFile.size / 1024);

          // Replace input files list using DataTransfer
          const dataTransfer = new DataTransfer();
          dataTransfer.items.add(optimizedFile);
          this.files = dataTransfer.files;

          optStatus.innerHTML = `<i class="fa-solid fa-circle-check text-success me-1"></i> Optimized for high speed: <strong>${originalSizeMB} MB &rarr; ${newSizeKB} KB</strong> (crisp quality preserved)`;
        } catch (err) {
          optStatus.innerHTML = `File ready: ${originalSizeMB} MB`;
        }
      } else {
        optStatus.innerHTML = `<i class="fa-solid fa-circle-check text-success me-1"></i> Ready for upload (${originalSizeMB} MB)`;
      }
    });
  }

  function compressImageFile(file, maxWidth, quality) {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = (e) => {
        const img = new Image();
        img.src = e.target.result;
        img.onload = () => {
          let width = img.width;
          let height = img.height;

          if (width > maxWidth) {
            height = Math.round((height * maxWidth) / width);
            width = maxWidth;
          }

          const canvas = document.createElement("canvas");
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, width, height);

          canvas.toBlob((blob) => {
            if (!blob) return resolve(file);
            const optimized = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
              type: "image/jpeg",
              lastModified: Date.now()
            });
            resolve(optimized);
          }, "image/jpeg", quality);
        };
        img.onerror = () => resolve(file);
      };
      reader.onerror = () => resolve(file);
    });
  }

  // 2. Submit Button Loading Feedback
  const form = document.getElementById("newListingForm");
  const submitBtn = document.getElementById("submitBtn");
  const btnText = document.getElementById("btnText");
  const btnSpinner = document.getElementById("btnSpinner");

  if (form) {
    form.addEventListener("submit", function () {
      if (this.checkValidity()) {
        submitBtn.style.opacity = "0.8";
        submitBtn.style.pointerEvents = "none";
        btnText.innerText = "Uploading to Cloud & Publishing...";
        btnSpinner.classList.remove("d-none");
      }
    });
  }
</script>
