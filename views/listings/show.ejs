<% layout("/layouts/boilerplate") %>

<!-- Header Section (Matching Photo 3) -->
<header class="show-header">
  <h1 class="show-title"><%= listing.title %></h1>
  
  <div class="show-meta-bar">
    <div class="show-meta-left">
      <span class="d-inline-flex align-items-center gap-1 text-dark fw-bold">
        <i class="fa-solid fa-star text-dark" style="font-size: 0.85rem;"></i> 4.95
      </span>
      <span>&middot;</span>
      <span class="text-decoration-underline fw-medium">
        <%= listing.reviews ? listing.reviews.length + 18 : 124 %> reviews
      </span>
      <span>&middot;</span>
      <span>
        <i class="fa-solid fa-location-dot me-1 text-secondary"></i>
        <%= listing.location %>, <%= listing.country %>
      </span>
    </div>

    <div class="show-actions-right">
      <button class="btn-action-ghost" type="button" onclick="navigator.clipboard.writeText(window.location.href); alert('Listing link copied to clipboard!');">
        <i class="fa-solid fa-arrow-up-from-bracket"></i> Share
      </button>
      <button class="btn-action-ghost" type="button" id="saveHeartBtn" onclick="this.querySelector('i').classList.toggle('fa-solid'); this.querySelector('i').classList.toggle('fa-regular'); this.querySelector('i').classList.toggle('text-danger');">
        <i class="fa-regular fa-heart"></i> Save
      </button>

      <!-- Owner Controls (Edit & Delete) -->
      <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="ms-2 d-inline-flex gap-2">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-dark" style="border-radius: 9999px; padding: 4px 14px;">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this listing?');">
            <button class="btn btn-sm btn-outline-danger" style="border-radius: 9999px; padding: 4px 14px;">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</header>

<!-- Bento Photo Showcase (Matching Photo 3) -->
<section class="bento-gallery">
  <!-- Hero / Primary Photo -->
  <div class="bento-item bento-main">
    <img 
      src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=1200' %>" 
      alt="<%= listing.title %> hero photograph"
    >
  </div>

  <!-- Secondary Curated Architectural / Interior Details -->
  <div class="bento-item bento-sub">
    <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=600&auto=format&fit=crop" alt="Bedroom suite">
  </div>
  <div class="bento-item bento-sub">
    <img src="https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=600&auto=format&fit=crop" alt="Courtyard view">
  </div>
  <div class="bento-item bento-sub">
    <img src="https://images.unsplash.com/photo-1578683010236-d716f9a3f461?q=80&w=600&auto=format&fit=crop" alt="Dining area">
  </div>
  <div class="bento-item bento-sub">
    <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?q=80&w=600&auto=format&fit=crop" alt="Terrace lounge">
  </div>

  <button class="btn-show-photos" type="button">
    <i class="fa-solid fa-grip"></i> Show all photos
  </button>
</section>

<!-- Split Layout: Left Content & Right Sticky Reservation Card (Photo 3) -->
<div class="show-split-layout">
  
  <!-- Left Column: Details, Features, Amenities & Reviews -->
  <div class="show-content-col">
    
    <!-- Host Profile & Superhost Badges -->
    <div class="host-profile-card">
      <div class="host-avatar-lg d-flex align-items-center justify-content-center text-dark fw-bold fs-5">
        <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'W' %>
      </div>
      <div>
        <div class="host-title">
          Hosted by <%= listing.owner ? listing.owner.username : 'Wanderlust Partner' %> &middot; Superhost
        </div>
        <div class="host-subtitle">Key highlights</div>
        <div class="highlights-list">
          <div class="highlight-row">
            <i class="fa-solid fa-check"></i>
            <span>Experienced host with exceptional reviews</span>
          </div>
          <div class="highlight-row">
            <i class="fa-solid fa-check"></i>
            <span>Responsive time under 1 hour</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Description & Features -->
    <section class="mb-4">
      <h2 class="show-section-title">Description & Features</h2>
      <p class="show-description-text">
        <%= listing.description %>
      </p>

      <div class="d-flex flex-wrap gap-2 mt-2">
        <span class="badge bg-light text-dark border p-2 px-3 fw-normal" style="border-radius: 9999px;">
          <i class="fa-solid fa-laptop me-1 text-secondary"></i> Dedicated workspace
        </span>
        <span class="badge bg-light text-dark border p-2 px-3 fw-normal" style="border-radius: 9999px;">
          <i class="fa-solid fa-square-parking me-1 text-secondary"></i> Free parking
        </span>
        <span class="badge bg-light text-dark border p-2 px-3 fw-normal" style="border-radius: 9999px;">
          <i class="fa-solid fa-landmark me-1 text-secondary"></i> Cultural hub
        </span>
      </div>
    </section>

    <!-- Amenities Grid (Photo 3) -->
    <section>
      <h2 class="show-section-title">Amenities</h2>
      <div class="amenities-grid">
        <div class="amenity-item">
          <i class="fa-solid fa-wifi"></i>
          <span>Fast Wifi (100+ Mbps)</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-snowflake"></i>
          <span>Air conditioning & heating</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-square-parking"></i>
          <span>Free private parking on premises</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-water-ladder"></i>
          <span>Heated courtyard pool</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-kitchen-set"></i>
          <span>Fully-equipped artisan kitchen</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-archway"></i>
          <span>Heritage courtyard architecture</span>
        </div>
      </div>
    </section>

    <!-- Guest Reviews Section (Photo 3) -->
    <section class="reviews-section">
      <div class="d-flex align-items-center gap-2 mb-3">
        <h2 class="show-section-title m-0">Guest Reviews</h2>
        <div class="ms-2 d-inline-flex align-items-center gap-1">
          <i class="fa-solid fa-star text-warning"></i>
          <span class="fw-bold">4.95</span>
          <span class="text-secondary">&middot; <%= listing.reviews ? listing.reviews.length : 0 %> reviews</span>
        </div>
      </div>

      <!-- Reviews Cards Grid -->
      <div class="reviews-grid">
        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <% for(let review of listing.reviews) { %>
            <div class="review-card-modern">
              <div class="review-author-row">
                <div class="review-avatar-small">
                  <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'G' %>
                </div>
                <div>
                  <h4 class="review-author-name">
                    <%= review.author ? review.author.username : 'Guest' %>
                  </h4>
                  <div class="review-date">
                    <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'Verified Stay' %>
                  </div>
                </div>
              </div>

              <div class="review-rating-stars mb-2">
                <% for(let s = 1; s <= 5; s++) { %>
                  <i class="fa-<%= s <= (review.rating || 5) ? 'solid' : 'regular' %> fa-star"></i>
                <% } %>
              </div>

              <p class="review-comment-body">
                <%= review.comment %>
              </p>

              <!-- Review Delete Button (if author) -->
              <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
                  <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" style="font-size: 0.8rem;">
                    <i class="fa-regular fa-trash-can me-1"></i> Delete review
                  </button>
                </form>
              <% } %>
            </div>
          <% } %>
        <% } else { %>
          <!-- Default preview reviews when newly created -->
          <div class="review-card-modern">
            <div class="review-author-row">
              <div class="review-avatar-small">A</div>
              <div>
                <h4 class="review-author-name">Amit</h4>
                <div class="review-date">October 2026</div>
              </div>
            </div>
            <div class="review-rating-stars mb-2">
              <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            <p class="review-comment-body">
              Beautifully maintained, absolutely loved the tranquil atmosphere and attentive host!
            </p>
          </div>

          <div class="review-card-modern">
            <div class="review-author-row">
              <div class="review-avatar-small">K</div>
              <div>
                <h4 class="review-author-name">Kavita</h4>
                <div class="review-date">September 2026</div>
              </div>
            </div>
            <div class="review-rating-stars mb-2">
              <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            <p class="review-comment-body">
              A gentle, timeless stay. The courtyard and breakfast in the morning were unforgettable.
            </p>
          </div>
        <% } %>
      </div>

      <!-- Add Review Form -->
      <% if (currUser) { %>
        <div class="form-page-card mt-4 p-4 mx-0" style="max-width: 100%;">
          <h3 class="fs-5 fw-bold mb-3 font-serif">Leave a Review</h3>
          <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
              <label for="ratingRange" class="form-label small fw-semibold text-secondary">Rating: <span id="ratingVal" class="text-dark fw-bold">5</span> Stars</label>
              <input type="range" id="ratingRange" name="review[rating]" min="1" max="5" value="5" class="form-range" oninput="document.getElementById('ratingVal').innerText = this.value">
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label small fw-semibold text-secondary">Your Experience</label>
              <textarea name="review[comment]" id="comment" rows="3" class="form-control" placeholder="Tell future slow travelers about your stay..." required style="border-radius: var(--radius-sm); border-color: var(--border-subtle-2);"></textarea>
            </div>

            <button class="btn btn-dark" style="border-radius: var(--radius-pill); padding: 8px 24px; background: #1C1917;">
              Submit Review
            </button>
          </form>
        </div>
      <% } else { %>
        <div class="p-3 bg-white border rounded-3 mt-3 text-center text-secondary small">
          <a href="/login" class="text-dark fw-bold text-decoration-underline">Log in</a> to leave a review for this slow stay.
        </div>
      <% } %>
    </section>

  </div>

  <!-- Right Column: Sticky Booking / Reservation Widget (Photo 3) -->
  <div class="show-sidebar-col">
    <aside class="sticky-booking-card">
      
      <!-- Price & Rating Header -->
      <div class="booking-card-price-header">
        <div>
          <span class="booking-price-number">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "8,500" %></span>
          <span class="booking-price-period">/ night</span>
        </div>
        <div class="listing-rating">
          <i class="fa-solid fa-star text-warning"></i>
          <span>4.95</span>
        </div>
      </div>

      <!-- Date & Guest Input Box -->
      <div class="booking-inputs-grid">
        <div class="booking-dates-row">
          <div class="booking-input-block">
            <span class="booking-input-label">Check-in</span>
            <input type="text" class="booking-input-control" value="24/11/2026" id="checkInInput" readonly>
          </div>
          <div class="booking-input-block">
            <span class="booking-input-label">Check-out</span>
            <input type="text" class="booking-input-control" value="28/11/2026" id="checkOutInput" readonly>
          </div>
        </div>
        <div class="booking-input-block">
          <span class="booking-input-label">Guests</span>
          <select class="booking-input-control" id="guestSelector" style="cursor: pointer;">
            <option value="1">1 guest</option>
            <option value="2" selected>2 guests</option>
            <option value="3">3 guests</option>
            <option value="4">4 guests</option>
          </select>
        </div>
      </div>

      <!-- Action Button -->
      <button class="btn-reserve-action" type="button" onclick="alert('Reservation request initiated for <%= listing.title %>!');">
        Reserve
      </button>
      <div class="text-center text-muted small mb-3">You won't be charged yet</div>

      <!-- Price Breakdown (Photo 3) -->
      <% const basePrice = listing.price || 3500; %>
      <% const nights = 4; %>
      <% const stayTotal = basePrice * nights; %>
      <% const cleaningFee = 500; %>
      <% const serviceFee = 1200; %>
      <% const grandTotal = stayTotal + cleaningFee + serviceFee; %>

      <div class="price-breakdown-box">
        <div class="price-breakdown-row">
          <span class="text-decoration-underline">&#8377;<%= basePrice.toLocaleString("en-IN") %> &times; <%= nights %> nights</span>
          <span>&#8377;<%= stayTotal.toLocaleString("en-IN") %></span>
        </div>
        <div class="price-breakdown-row">
          <span class="text-decoration-underline">Cleaning fee</span>
          <span>&#8377;<%= cleaningFee.toLocaleString("en-IN") %></span>
        </div>
        <div class="price-breakdown-row">
          <span class="text-decoration-underline">Wanderlust service fee</span>
          <span>&#8377;<%= serviceFee.toLocaleString("en-IN") %></span>
        </div>
        <div class="price-breakdown-row price-breakdown-total">
          <span>Total before taxes</span>
          <span>&#8377;<%= grandTotal.toLocaleString("en-IN") %></span>
        </div>
      </div>

    </aside>
  </div>

</div>
