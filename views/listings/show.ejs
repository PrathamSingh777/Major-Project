<% layout("/layouts/boilerplate")%>
<body>
    
    <div class="row offset-4 mt-3 ">
        <div class="col-8"></div>
        
        <h2><%= listing.title%></h2>

        <div class="card col-7 listing-card" >
            <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="...">
            <div class="card-body">
                <p class="card-text">Owned by: <b><%= listing.owner.username %></b></p><br>
                <p class="card-text"><%= listing.description%></p>
                <li>  &#8377  <%=  listing.price.toLocaleString("en-IN")%></li>
                <li><%= listing.location%></li>
                <li><%= listing.country%></li>
            </div>
        </div>

        <%if(currUser && listing.owner._id.equals(currUser._id)){%>
            <div style="display: flex ">
                <div class="mb-2 ">
                    <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark  show-btn">Edit</a>
                </div>
                <div class="mb-3">
                    <form method="post" action="/listings/<%=listing._id%>?_method=DELETE" s >
                        <button class="btn btn-dark  show-btn" >delete</button>
                    </form>
                </div>
            </div>
        <%}%>

        <div class="col-7"> 
        
            <%if(currUser){%>
                <h3>Leave a review</h3>
                <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation"> 
                    <div class="mt-3 mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <input  type="range" id="rating" name="review[rating]" min="1" max="5"  class="form-range">
                    </div>

                    <div class="mt-3 mb-3">
                        <label for="comment" class="form-label">comment</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                    </div>
                    <button class="btn btn-outline-dark mt-2 mb-2">Submit</button>
                </form>
            <%}%>

            <h2>All Reviews</h2>
            <div class="row row-cols-md-2">
                <%for(let review of listing.reviews){%>
                    <div class="card col mb-3 me-3"> 
                        <div class="card-body">
                            <h5 class="card-title">@<%= review.author ? review.author.username : 'Anonymous' %></h5>
                            <p class="card-text"><%=review.comment %></p>
                            <p class="card-text"><%=review.rating %> star</p>

                            <form class="mb-2"  method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                <button class="btn  btn-sm btn-dark">Delete</button>
                            </form>
                        </div>
                    </div>
                <%}%>
            </div>
        </div>
        </div>
    </body>